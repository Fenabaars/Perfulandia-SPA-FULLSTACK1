		{
			"name": "H16 - Carrito de Compras",
			"description": "Historia 16: Como Cliente, quiero agregar y quitar productos de mi carrito de compras, para preparar mi pedido antes de pagar.",
			"item": [
				{
					"name": "Obtener carrito por usuario",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/carrito/usuario/1",
							"host": ["{{base_url}}"],
							"path": ["api", "carrito", "usuario", "1"]
						},
						"description": "GET /api/carrito/usuario/{usuarioId}\n\nRetorna todos los ítems del carrito del usuario indicado."
					},
					"response": []
				},
				{
					"name": "Agregar producto al carrito",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usuarioId\": 1,\n    \"perfumeId\": 2,\n    \"nombrePerfume\": \"Dior Sauvage\",\n    \"precio\": 75990.0,\n    \"cantidad\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/carrito",
							"host": ["{{base_url}}"],
							"path": ["api", "carrito"]
						},
						"description": "POST /api/carrito\n\nAgrega un producto al carrito. Si el perfume ya existe en el carrito del usuario, incrementa la cantidad automáticamente."
					},
					"response": []
				},
				{
					"name": "Agregar otro producto al carrito",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usuarioId\": 1,\n    \"perfumeId\": 5,\n    \"nombrePerfume\": \"Chanel No. 5\",\n    \"precio\": 89990.0,\n    \"cantidad\": 2\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/carrito",
							"host": ["{{base_url}}"],
							"path": ["api", "carrito"]
						},
						"description": "Agrega un segundo producto distinto al carrito."
					},
					"response": []
				},
