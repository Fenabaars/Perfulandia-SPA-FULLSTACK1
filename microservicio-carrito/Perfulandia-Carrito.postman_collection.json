							"raw": "{{base_url}}/api/carrito/1?cantidad=3",
							"host": ["{{base_url}}"],
							"path": ["api", "carrito", "1"],
							"query": [
								{
									"key": "cantidad",
									"value": "3"
								}
							]
						},
						"description": "PUT /api/carrito/{id}?cantidad={nuevaCantidad}\n\nActualiza la cantidad del ítem con ID=1 a 3 unidades."
					},
					"response": []
				},
